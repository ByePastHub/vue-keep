{
  "name": "@bye_past/vue-keep-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm -F @bye_past/vue-keep dev",
    "dev:playground": "pnpm -F ecommerce-playground dev",
    "dev:showcase": "pnpm -F playground-showcase dev",
    "docs:dev": "pnpm -F docs dev",
    "docs:build": "pnpm -F docs build",
    "build": "pnpm -r --filter='./packages/*' run build",
    "test": "pnpm -r --filter='./packages/*' run test",
    "test:e2e": "pnpm -F ecommerce-playground test:e2e",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --cache",
    "size": "pnpm -F @bye_past/vue-keep run size",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@size-limit/esbuild": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vue/test-utils": "^2.4.8",
    "commitlint": "^20.5.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-define-config": "^2.1.0",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "vue": "^3.5.33",
    "vue-eslint-parser": "^10.4.0",
    "vue-router": "^5.0.6"
  }
}
